# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB URI (MongoDB Atlas or local daemon, e.g. mongodb://127.0.0.1:27017/autonear)
MONGODB_URI=mongodb://127.0.0.1:27017/autonear

# CORS & Frontend Origins (Comma-separated for multiple origins if needed)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets & Expiries
JWT_ACCESS_SECRET=autonear_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=autonear_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Fog Service Integration & Shared Secret
FOG_SERVICE_URL=http://localhost:4100
FOG_SERVICE_SECRET=autonear_fog_shared_secret_token_xyz_2026

# Real-Time Service (Optional standalone Socket.IO or Pusher/Ably if not on persistent host)
SOCKET_IO_URL=http://localhost:5000

