# Fog Node Service Environment
PORT=4100
NODE_ENV=development

# Authoritative Cloud Backend URL
BACKEND_URL=http://localhost:5000

# Server-Side Pre-Shared Secret for Fog-to-Cloud Authentication
# (Never expose this in frontend bundles!)
FOG_SERVICE_SECRET=autonear_fog_shared_secret_token_xyz_2026

# Cache and Timeout Settings
CACHE_TTL_SECONDS=60
REQUEST_TIMEOUT_MS=4000

# Regional Node Identification
FOG_REGION_ID=us-west-bayarea-node-01
FOG_REGION_NAME=US West Bay Area Edge Zone

