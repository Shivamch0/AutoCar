# Frontend API Base URL
VITE_API_URL=http://localhost:5000/api/v1

# Optional Regional Fog Node URL (Accessible directly in local network / edge zone)
VITE_FOG_URL=http://localhost:4100

# Persistent Socket.IO / Real-Time Server URL (Falls back to HTTP polling if unavailable or on serverless)
VITE_SOCKET_URL=http://localhost:5000

